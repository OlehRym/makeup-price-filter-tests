{
  "name": "makeup-price-filter-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript автотести фільтра «Ціна» на сторінці категорії makeup.com.ua (desktop + mobile)",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:unit": "playwright test --project=unit",
    "test:headed": "playwright test --headed --workers=1",
    "test:strict": "STRICT_PRICE_CHECK=1 playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
