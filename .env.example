# Базовий URL магазину
BASE_URL=https://makeup.com.ua
# Сторінка категорії, на якій тестується фільтр (будь-яка категорія з фільтром «Вартість»)
CATEGORY_PATH=/ua/categorys/3/
# Частка товарів, ціна яких може не відповідати діапазону (дефекти даних), 0..1
PRICE_MISMATCH_TOLERANCE=0.05
# 1 = нульова толерантність (будь-який товар поза діапазоном валить тест)
STRICT_PRICE_CHECK=0
